
@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Follow-up Details";
}

<h2 class="mb-4">Follow-up Details</h2>

<div class="card shadow-sm p-4">
    <h4>@Model.Subject</h4>

    <dl class="row mt-3">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>

        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Follow-up Date</dt>
        <dd class="col-sm-9">@Model.FollowUpDate.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Notes</dt>
        <dd class="col-sm-9">@Model.Notes</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToString("dd-MM-yyyy")</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-primary">Edit</a>

        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>
