
@model AcxiomCRM.Models.FollowUp

@{
    ViewData["Title"] = "Delete Follow-up";
}

<h2 class="mb-3">Delete Follow-up</h2>

<div class="card shadow-sm p-4">
    <div class="alert alert-warning">
        Are you sure you want to delete this follow-up?
        This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>

        <dt class="col-sm-3">Subject</dt>
        <dd class="col-sm-9">@Model.Subject</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.FollowUpDate.ToString("dd-MM-yyyy")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
