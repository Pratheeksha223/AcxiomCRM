
@model IEnumerable<AcxiomCRM.Models.FollowUp>

@{
    ViewData["Title"] = "Follow-ups";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Follow-up Management</h2>
        <p class="text-muted">Track and manage customer follow-ups.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">+ Add Follow-up</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card shadow-sm p-3">
    <form asp-action="Index" method="get" class="d-flex gap-2 mb-3">
        <input name="searchString" class="form-control"
               placeholder="Search customer, subject or status..."
               value="@Context.Request.Query["searchString"]" />
        <button type="submit" class="btn btn-success">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </form>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Customer</th>
                    <th>Subject</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.CustomerName</td>
                            <td>@item.Subject</td>
                            <td>@item.FollowUpDate.ToString("dd-MM-yyyy")</td>
                            <td>@item.Type</td>
                            <td>
                                <span class="badge bg-info">@item.Status</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-info">View</a>

                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-primary">Edit</a>

                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">
                            No follow-ups found. Add your first follow-up!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
