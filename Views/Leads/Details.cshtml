
@model AcxiomCRM.Models.Lead

@{
    ViewData["Title"] = "Lead Details";
}

<div class="container py-4">
    <h2>Lead Details</h2>
    <div class="card p-4 mt-3">
        <p><strong>Name:</strong> @Model.LeadName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.Phone</p>
        <p><strong>Company:</strong> @Model.CompanyName</p>
        <p><strong>Source:</strong> @Model.Source</p>
        <p><strong>Status:</strong> @Model.Status</p>
        <p><strong>Notes:</strong> @Model.Notes</p>
        <p><strong>Created:</strong> @Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</p>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>
</div>
