
@model IEnumerable<AcxiomCRM.Models.Lead>

@{
    ViewData["Title"] = "Lead Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between mb-4">
        <div>
            <h2>Lead Management</h2>
            <p>Manage and organize potential customers.</p>
        </div>
        <a asp-action="Create" class="btn btn-success">+ Add Lead</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card p-3">
        <form asp-action="Index" method="get" class="d-flex mb-3">
            <input name="searchString" value="@ViewBag.SearchString"
                   class="form-control" placeholder="Search leads..." />
            <button class="btn btn-success ms-2">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Clear</a>
        </form>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Lead</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var lead in Model)
                {
                    <tr>
                        <td>@lead.Id</td>
                        <td>@lead.LeadName</td>
                        <td>@lead.Email</td>
                        <td>@lead.Phone</td>
                        <td>@lead.CompanyName</td>
                        <td>@lead.Source</td>
                        <td><span class="badge bg-success">@lead.Status</span></td>
                        <td>
                            <a asp-action="Details" asp-route-id="@lead.Id"
                               class="btn btn-sm btn-info">View</a>
                            <a asp-action="Edit" asp-route-id="@lead.Id"
                               class="btn btn-sm btn-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@lead.Id"
                               class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center">No leads found.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
