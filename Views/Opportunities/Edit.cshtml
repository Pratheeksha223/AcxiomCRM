
@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Edit Opportunity";
}

<h2 class="mb-3">Edit Opportunity</h2>

<div class="card shadow-sm p-4">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="OpportunityName" class="form-label">Opportunity Name</label>
            <input asp-for="OpportunityName" class="form-control" required />
            <span asp-validation-for="OpportunityName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label">Customer Name</label>
            <input asp-for="CustomerName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="CompanyName" class="form-label">Company Name</label>
            <input asp-for="CompanyName" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="DealValue" class="form-label">Deal Value (₹)</label>
            <input asp-for="DealValue" type="number" step="0.01"
                   min="0" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Stage" class="form-label">Stage</label>
            <select asp-for="Stage" class="form-select">
                <option value="Qualification">Qualification</option>
                <option value="Proposal">Proposal</option>
                <option value="Negotiation">Negotiation</option>
                <option value="Won">Won</option>
                <option value="Lost">Lost</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Open">Open</option>
                <option value="In Progress">In Progress</option>
                <option value="Won">Won</option>
                <option value="Lost">Lost</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date</label>
            <input asp-for="ExpectedCloseDate" type="date" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>

        <button type="submit" class="btn btn-success">Update Opportunity</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
