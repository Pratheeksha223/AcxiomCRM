
@model AcxiomCRM.Models.Opportunity

@{
    ViewData["Title"] = "Delete Opportunity";
}

<h2 class="mb-3">Delete Opportunity</h2>

<div class="card shadow-sm p-4">
    <div class="alert alert-warning">
        Are you sure you want to delete this opportunity?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Opportunity</dt>
        <dd class="col-sm-9">@Model.OpportunityName</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>

        <dt class="col-sm-3">Company</dt>
        <dd class="col-sm-9">@Model.CompanyName</dd>

        <dt class="col-sm-3">Deal Value</dt>
        <dd class="col-sm-9">₹@Model.DealValue.ToString("N2")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Confirm Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
