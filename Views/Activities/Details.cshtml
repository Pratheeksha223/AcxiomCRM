
@model AcxiomCRM.Models.Activity

@{
    ViewData["Title"] = "Activity Details";
}

<h2>Activity Details</h2>
<p class="text-muted">View complete activity information.</p>

<div class="card shadow-sm p-4">
    <dl class="row">
        <dt class="col-sm-3">Activity Name</dt>
        <dd class="col-sm-9">@Model.ActivityName</dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.CustomerName</dd>

        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.Type</dd>

        <dt class="col-sm-3">Activity Date</dt>
        <dd class="col-sm-9">@Model.ActivityDate.ToString("dd MMM yyyy")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.CreatedDate.ToString("dd MMM yyyy")</dd>
    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id"
           class="btn btn-primary">Edit</a>

        <a asp-action="Index"
           class="btn btn-secondary">Back</a>
    </div>
</div>
