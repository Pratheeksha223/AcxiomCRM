
@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="dashboard-heading">
    <div>
        <h2>Customer Details</h2>
        <p>View complete customer information.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        Back to Customers
    </a>
</div>

<div class="dashboard-panel">
    <h5 class="mb-4">Customer Information</h5>

    <div class="row g-4">
        <div class="col-md-6">
            <label class="text-muted">Customer ID</label>
            <h6>@Model.Id</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">Customer Name</label>
            <h6>@Model.CustomerName</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">Email</label>
            <h6>@Model.Email</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">Phone</label>
            <h6>@Model.Phone</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">Company</label>
            <h6>@Model.CompanyName</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">Status</label>
            <h6>@Model.Status</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">City</label>
            <h6>@Model.City</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">State</label>
            <h6>@Model.State</h6>
        </div>

        <div class="col-12">
            <label class="text-muted">Address</label>
            <h6>@Model.Address</h6>
        </div>

        <div class="col-md-6">
            <label class="text-muted">Created Date</label>
            <h6>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</h6>
        </div>
    </div>

    <hr />

    <a asp-action="Edit" asp-route-id="@Model.Id"
       class="btn btn-primary">
        <i class="bi bi-pencil"></i> Edit Customer
    </a>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Back
    </a>
</div>
