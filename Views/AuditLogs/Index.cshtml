
@model IEnumerable<AcxiomCRM.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">Audit Logs</h2>
        <p class="text-muted">Track user actions and system activities.</p>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <form asp-controller="AuditLogs" asp-action="Index" method="get"
              class="d-flex gap-2">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search user, action or record..." />

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Search
            </button>

            <a asp-controller="AuditLogs"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Reset
            </a>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Module</th>
                        <th>Details</th>
                        <th>Date &amp; Time (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var count = 1;

                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@count</td>
                                <td>
                                    <i class="bi bi-person-circle me-1"></i>
                                    @log.UserName
                                </td>
                                <td>
                                    @if (log.Action == "Created")
                                    {
                                        <span class="badge bg-success">Created</span>
                                    }
                                    else if (log.Action == "Updated")
                                    {
                                        <span class="badge bg-primary">Updated</span>
                                    }
                                    else if (log.Action == "Deleted")
                                    {
                                        <span class="badge bg-danger">Deleted</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @log.Action
                                        </span>
                                    }
                                </td>
                                <td>@log.EntityName</td>
                                <td>@log.Details</td>
                                <td>@log.Timestamp.ToString("dd MMM yyyy, hh:mm tt")</td>
                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="bi bi-clock-history fs-3 d-block mb-2"></i>
                                No audit logs found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-muted small">
            Showing the latest 200 matching records.
        </div>
    </div>
</div>
